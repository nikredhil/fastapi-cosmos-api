# Copy to .env and adjust. The app runs out-of-the-box with the defaults below
# (in-memory DB, dev JWT secret) so no Azure account is required to try it.

APP_NAME="Task Tracker API"
ENVIRONMENT=local
LOG_LEVEL=INFO

# Storage backend: "memory" (default, zero setup) or "cosmos"
DB_BACKEND=memory

# Azure Cosmos DB — only needed when DB_BACKEND=cosmos
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=tasktracker

# JWT (HS256). Override the secret in any real deployment.
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Chat assistant (Streamlit UI)
#   auto   = use Ollama if reachable, else the rule-based engine (default)
#   ollama = force Ollama (falls back to rules on error)
#   rules  = force the deterministic rule-based engine
CHAT_BACKEND=auto
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
