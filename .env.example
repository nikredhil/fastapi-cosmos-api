# Copy to .env and adjust. The app runs out-of-the-box with the defaults below
# (durable local JSON DB, dev JWT secret) so no cloud account is required to try it.

APP_NAME="RentWise — Rental Manager"
ENVIRONMENT=local
LOG_LEVEL=INFO

# Storage backend:
#   file (default, durable local JSON, survives restarts) | memory | cosmos
DB_BACKEND=file

# Directory for the JSON-file backend (only used when DB_BACKEND=file)
DATA_DIR=./data

# Where uploaded contract images are stored
UPLOADS_DIR=./data/uploads

# Anthropic (Claude) — parses uploaded contract photos into structured fields.
# Leave ANTHROPIC_API_KEY blank to disable auto-parse and fall back to manual entry.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Azure Cosmos DB — only needed when DB_BACKEND=cosmos
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=rentwise

# Microsoft Entra ID (Azure AD) sign-in.
# Register a Single-page application in the Azure portal (account type:
# "any org directory and personal Microsoft accounts"), then paste its
# Application (client) ID here. The SPA reads this via GET /auth/config.
AZURE_CLIENT_ID=
# Default authority allows work + personal accounts. For single-tenant, use
# https://login.microsoftonline.com/<your-tenant-id>
AZURE_AUTHORITY=https://login.microsoftonline.com/common

# Chat assistant backend
#   auto   = use Ollama if reachable, else the rule-based engine (default)
#   ollama = force Ollama (falls back to rules on error)
#   rules  = force the deterministic rule-based engine
CHAT_BACKEND=auto
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
